# CHUBB Actuarial Analytics & Conversational AI — Environment Configuration
# Copy this file to .env and adjust values if connecting an external LLM provider.

# Repository paths (optional overrides; defaults resolved via chubb.infrastructure.paths)
CHUBB_DATA_PATH=data/curated/data.json
CHUBB_RULES_PATH=config/business_rules/actuarial_rules.json

# Optional LLM Provider Configuration (Deterministic Grounded Engine runs without LLM)
CHUBB_LLM_PROVIDER=none
CHUBB_OLLAMA_ENDPOINT=http://localhost:11434/api/generate
CHUBB_OLLAMA_MODEL=llama3:8b
CHUBB_OPENAI_API_URL=http://localhost:8000/v1
CHUBB_OPENAI_API_KEY=EMPTY
CHUBB_OPENAI_MODEL=llama-3-8b-instruct

